---
import { getImage } from "astro:assets";

import "@fontsource-variable/fraunces";
import "../styles/global.css";
import goldMiroir from "../assets/gold-miroir.jpg";
import { site } from "../data/site";

type Props = {
  titre: string;
  description: string;
  /** Les pages utilitaires (carte, confidentialité) n'ont pas la navigation */
  navigation?: boolean;
  /** Une page qui n'a de sens qu'après une action n'a rien à faire dans l'index */
  indexable?: boolean;
};

const { titre, description, navigation = true, indexable = true } = Astro.props;
const canonique = new URL(Astro.url.pathname, Astro.site);

// Toutes les photos disponibles sont verticales, donc un cadrage 1200 x 630
// en découpe une bande fine : le choix de la photo compte plus que celui de
// la position. Celle-ci est la seule dont la bande centrale tient debout —
// son visage, son bras levé, et le cours derrière elle dans le miroir.
// Cadrer `portrait.jpg` depuis le haut donnait 85 % de dalles de plafond,
// et c'est cette image-là qui s'affiche quand on partage le lien par message.
const partage = await getImage({
  src: goldMiroir,
  width: 1200,
  height: 630,
  format: "jpeg",
  fit: "cover",
  position: "centre",
});
const imagePartage = new URL(partage.src, Astro.site);
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {!indexable && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imagePartage} />
    {
      /* Messenger et WhatsApp affichent l'aperçu dès le premier partage
        quand les dimensions sont annoncées, sans attendre de télécharger
        l'image pour les mesurer. */
    }
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Mariane Carlo Rollot, bras levé, mène un cours de Zumba dans une salle communautaire"
    />
    <meta property="og:site_name" content={site.nom} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0b5c64" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      /* iOS ignore les icônes du manifeste et n'accepte pas le SVG : sans ce
        PNG, l'écran d'accueil affiche une capture de la page. */
    }
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      // Posé dans le <head> pour être en place avant que la première vidéo
      // existe : l'écoute en capture attrape l'événement « play » et met en
      // pause avant qu'une image bouge.
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.addEventListener(
          "play",
          (evenement) => {
            const cible = evenement.target;
            if (
              cible instanceof HTMLVideoElement &&
              cible.dataset.anime !== undefined
            ) {
              cible.pause();
            }
          },
          true,
        );
      }
    </script>

    <slot name="tete" />
  </head>

  <body>
    <a class="saut-navigation" href="#contenu">Aller au contenu</a>
    {navigation && <slot name="navigation" />}
    <main id="contenu">
      <slot />
    </main>
    <slot name="pied" />
  </body>
</html>
