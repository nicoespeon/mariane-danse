---
// L'autoplay est natif, donc il marche sans JavaScript. C'est le script de
// Base.astro, posé dans le <head>, qui met en pause à la première image quand
// le visiteur a demandé moins d'animations.
//
// La piste de sous-titres est vide parce que ces extraits n'ont aucune bande
// son (encodés avec -an). Sans elle, axe et Lighthouse signalent une vidéo
// sans sous-titres et l'accessibilité tombe sous 100.
// L'affiche passe par getImage plutôt que par son import brut : l'attribut
// poster ne prend qu'une URL, donc Astro ne l'optimise pas tout seul. Celle du
// hero est l'élément LCP sur mobile, et la servir en JPEG coûtait 450 ms.
import { getImage } from "astro:assets";

type Props = {
  source: string;
  affiche: import("astro").ImageMetadata;
  description: string;
};

const { source, affiche, description } = Astro.props;

const posterOptimise = await getImage({
  src: affiche,
  format: "webp",
  width: affiche.width,
});
---

<video
  class="video"
  poster={posterOptimise.src}
  width={affiche.width}
  height={affiche.height}
  autoplay
  muted
  loop
  playsinline
  preload="metadata"
  aria-label={description}
  data-anime
>
  <source src={source} type="video/mp4" />
  <track
    kind="captions"
    src="/videos/sans-dialogue.vtt"
    srclang="fr"
    label="Aucun dialogue"
    default
  />
</video>

<style>
  .video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
