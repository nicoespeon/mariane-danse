---
import { getCollection } from "astro:content";
import { licence } from "../data/site";

// Tant qu'aucun témoignage n'est confirmé, la section disparaît du build
// plutôt que d'afficher du faux.
const temoignages = await getCollection(
  "temoignages",
  ({ data }) => data.publie,
);
---

{
  temoignages.length > 0 && (
    <section class="section section--creuse" id="temoignages">
      <div class="enveloppe">
        <h2>Ce qu'on dit de ses cours</h2>
        <ul class="temoignages">
          {temoignages.map((temoignage) => (
            <li>
              <figure class="temoignage">
                <blockquote>
                  <p>{temoignage.data.citation}</p>
                </blockquote>
                <figcaption>
                  <strong>{temoignage.data.auteur}</strong>
                  {temoignage.data.source.type === "organisme" ? (
                    <span>
                      {temoignage.data.source.fonction},{" "}
                      {temoignage.data.source.organisme}
                    </span>
                  ) : (
                    <span>
                      <a href={licence.profil} rel="noopener">
                        Avis publié sur sa fiche ZIN
                      </a>
                    </span>
                  )}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .temoignages {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
  }

  /* Sans ça, la figure garde sa hauteur naturelle et les cartes s'arrêtent
     toutes à une hauteur différente. */
  .temoignages li {
    display: grid;
  }

  .temoignage {
    margin: 0;
    /* Le nom et le lien se calent en bas : d'une carte à l'autre les
       citations n'ont pas la même longueur, et des pieds à des hauteurs
       différentes donnent une rangée de travers. */
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background: #fff;
    border-radius: var(--rayon-large);
    box-shadow: var(--ombre-douce);
  }

  .temoignage blockquote {
    margin: 0 0 1rem;
  }

  .temoignage blockquote p {
    font-family: var(--police-titre);
    font-size: 1.2rem;
    line-height: 1.45;
    margin: 0;
  }

  .temoignage blockquote p::before {
    content: "«\00a0";
  }

  .temoignage blockquote p::after {
    content: "\00a0»";
  }

  .temoignage figcaption {
    margin-top: auto;
    display: grid;
    font-size: 0.9rem;
    color: var(--encre-doux);
  }
</style>
