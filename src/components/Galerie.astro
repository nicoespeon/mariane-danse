---
import { Image } from "astro:assets";
import Video from "./Video.astro";
import IconeInstagram from "./IconeInstagram.astro";
import { site } from "../data/site";

import goldAssis from "../assets/gold-assis.jpg";
import goldMiroir from "../assets/gold-miroir.jpg";
import goldVerticalAffiche from "../assets/gold-vertical-affiche.jpg";
import kids from "../assets/kids.jpg";
import mamansBebes from "../assets/mamans-bebes.jpg";
import studioSourire from "../assets/studio-sourire.jpg";
import danseAujourdhui from "../assets/danse-aujourdhui.jpg";
import studioCoursAffiche from "../assets/studio-cours-affiche.jpg";
import portrait from "../assets/portrait.jpg";

// Toutes les images viennent du téléphone de Mariane, donc verticales. Le
// gabarit garde un seul format et fait varier la taille : deux cases doubles
// cassent la régularité sans obliger à recadrer chaque photo autrement.
//
// Le cadrage recherché — Mariane nette devant, participants au loin ou dans
// le miroir — évite d'avoir à collecter des autorisations de droit à l'image.
type Element = { alt: string; grand?: true } & (
  | { type: "image"; image: import("astro").ImageMetadata }
  | {
      type: "video";
      source: string;
      affiche: import("astro").ImageMetadata;
    }
);

const media: Element[] = [
  {
    type: "image",
    image: goldAssis,
    grand: true,
    alt: "Vue de dos de Mariane assise sur une chaise, bras tendus vers le haut, devant une dizaine d'aînés assis qui reprennent le mouvement.",
  },
  {
    type: "video",
    source: "/videos/gold-vertical.mp4",
    affiche: goldVerticalAffiche,
    alt: "Douze secondes d'un cours de Zumba Gold en salle communautaire, sans le son.",
  },
  {
    type: "image",
    image: kids,
    alt: "Mariane, bras levé, anime une ronde dansée dans une classe de maternelle.",
  },
  {
    type: "image",
    image: studioSourire,
    alt: "Mariane avance vers l'objectif en riant, dans un studio de danse.",
  },
  {
    type: "image",
    image: goldMiroir,
    alt: "Mariane de profil dans une salle communautaire, bras levé, le cours qui la suit visible dans le miroir.",
  },
  {
    type: "image",
    image: mamansBebes,
    alt: "Mariane, genou levé, mène un cours devant un petit groupe de mamans dans un studio.",
  },
  {
    type: "image",
    image: danseAujourdhui,
    alt: "Mariane, pieds nus, la jambe tendue à hauteur d'épaule contre un mur blanc.",
  },
  {
    type: "video",
    source: "/videos/studio-cours.mp4",
    affiche: studioCoursAffiche,
    alt: "Douze secondes d'un cours d'adultes en studio, sans le son.",
  },
  {
    type: "image",
    image: portrait,
    alt: "Mariane en studio, bras ouverts, en plein tour sur elle-même.",
  },
];
---

<section class="section" id="galerie">
  <div class="enveloppe">
    <h2>Une séance, en images</h2>
    <p class="chapeau">
      À quoi ressemble une séance avec Mariane&nbsp;: de l'énergie, de la
      bienveillance, et du plaisir.
    </p>

    <div class="galerie-cadre">
      <div class="galerie">
        {
          media.map((element) => (
            <figure
              class:list={[
                "galerie__cadre",
                element.grand && "galerie__cadre--grand",
              ]}
            >
              {element.type === "video" ? (
                <Video
                  source={element.source}
                  affiche={element.affiche}
                  description={element.alt}
                />
              ) : (
                <Image
                  src={element.image}
                  alt={element.alt}
                  widths={[320, 640]}
                  sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 90vw"
                />
              )}
            </figure>
          ))
        }
      </div>
    </div>

    {
      site.instagram.actif && (
        <a
          class="instagram"
          href={`https://instagram.com/${site.instagram.handle}`}
          rel="me noopener"
        >
          <span class="instagram__logo">
            <IconeInstagram taille="2rem" degrade={true} />
          </span>
          <span class="instagram__texte">
            <strong>Ses vidéos, semaine après semaine</strong>
            <span>@{site.instagram.handle} sur Instagram</span>
          </span>
        </a>
      )
    }
  </div>
</section>

<style>
  /* Les médias viennent tous du téléphone de Mariane, donc verticaux. Le
     gabarit suit le matériau plutôt que l'inverse. */
  /* Le nombre de colonnes est fixe par palier, pas en auto-fill : la case
     double occupe 2 colonnes ET 2 rangées, donc la hauteur de rangée doit
     valoir la largeur de colonne fois 4/3 pour que tout reste au format
     3/4. C'est ce calcul qui remplit la grille sans trou. Neuf cases dont
     une double font 12 unités, un compte qui tombe juste sur 2, 3 et 4
     colonnes. */
  .galerie-cadre {
    container-type: inline-size;
    margin-top: 2.5rem;
  }

  .galerie {
    --colonnes: 2;
    --gouttiere: 1.25rem;
    display: grid;
    gap: var(--gouttiere);
    grid-template-columns: repeat(var(--colonnes), 1fr);
    grid-auto-rows: calc(
      (100cqw - (var(--colonnes) - 1) * var(--gouttiere)) / var(--colonnes) *
        4 / 3
    );
  }

  @container (min-width: 34rem) {
    .galerie {
      --colonnes: 3;
    }
  }

  @container (min-width: 52rem) {
    .galerie {
      --colonnes: 4;
    }
  }

  .galerie__cadre--grand {
    grid-column: span 2;
    grid-row: span 2;
  }

  .galerie__cadre {
    margin: 0;
    height: 100%;
    overflow: hidden;
    border-radius: var(--rayon);
    background: var(--mer-brume);
  }

  .galerie__cadre :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* La photo respire dans son cadre, qui la rogne déjà. `scale` plutôt que
     `transform` : la propriété est indépendante, il n'y a rien à écraser.
     Réservé aux pointeurs — sur un écran tactile le survol reste collé après
     le tap, et la vignette resterait agrandie. */
  @media (hover: hover) {
    .galerie__cadre :global(img),
    .galerie__cadre :global(video) {
      transition: scale 400ms ease;
    }

    .galerie__cadre:hover :global(img),
    .galerie__cadre:hover :global(video) {
      scale: 1.04;
    }
  }

  .instagram {
    margin-top: 3rem;
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 2rem 1.25rem 1.25rem;
    border-radius: var(--rayon-large);
    background: var(--mer-sombre);
    color: var(--sable);
    text-decoration: none;
    box-shadow: var(--ombre-douce);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .instagram:hover {
    color: var(--sable);
    transform: translateY(-2px);
    box-shadow: var(--ombre-levee);
  }

  /* Le blanc laisse le dégradé d'Instagram exister pour ce qu'il est, au
     lieu de le noyer dans le vert du bloc. */
  .instagram__logo {
    display: grid;
    place-items: center;
    padding: 0.75rem;
    border-radius: var(--rayon);
    background: #fff;
  }

  .instagram__texte {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .instagram__texte strong {
    font-size: 1.1rem;
  }

  .instagram__texte span {
    font-size: 0.95rem;
    color: var(--mer-clair);
  }
</style>
