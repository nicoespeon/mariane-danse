---
import MediaAbsent from "./MediaAbsent.astro";
import IconeInstagram from "./IconeInstagram.astro";
import { site } from "../data/site";

// TODO: remplacer par <Image /> et <video> une fois les médias fournis.
// Le cadrage retenu — Mariane nette au premier plan, participants de dos ou
// flous — évite d'avoir à collecter des autorisations de droit à l'image.
const emplacements = [
  {
    legende: "Zumba Gold en résidence — variante assise sur chaise",
    ratio: "4 / 3",
  },
  { legende: "Zumba Kids — plan large, enfants en mouvement", ratio: "4 / 3" },
  {
    legende: "Portrait de Mariane — sert aussi à l'aperçu de partage",
    ratio: "1 / 1",
  },
  { legende: "Vidéo verticale 15-30 s — Zumba Gold", ratio: "9 / 16" },
  { legende: "Vidéo verticale 15-30 s — Zumba Kids", ratio: "9 / 16" },
  { legende: "Vidéo verticale 15-30 s — mamans-bébés", ratio: "9 / 16" },
];
---

<section class="section" id="galerie">
  <div class="enveloppe">
    <h2>Une séance, en images</h2>
    <p class="chapeau">
      À quoi ressemble une séance avec Mariane&nbsp;: de l'énergie, de la
      bienveillance, et du plaisir.
    </p>

    <div class="galerie">
      {
        emplacements.map((emplacement) => (
          <MediaAbsent
            legende={emplacement.legende}
            ratio={emplacement.ratio}
          />
        ))
      }
    </div>

    {
      site.instagram.actif && (
        <a
          class="instagram"
          href={`https://instagram.com/${site.instagram.handle}`}
          rel="me noopener"
        >
          <IconeInstagram taille="2rem" />
          <span class="instagram__texte">
            <strong>Ses vidéos, semaine après semaine</strong>
            <span>@{site.instagram.handle} sur Instagram</span>
          </span>
        </a>
      )
    }
  </div>
</section>

<style>
  .galerie {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }

  .instagram {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.25rem;
    padding: 1rem 1.75rem;
    border-radius: var(--rayon-large);
    background: var(--mer-sombre);
    color: var(--sable);
    text-decoration: none;
    box-shadow: var(--ombre-douce);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .instagram:hover {
    color: var(--sable);
    transform: translateY(-2px);
    box-shadow: var(--ombre-levee);
  }

  .instagram__texte {
    display: grid;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .instagram__texte span {
    font-size: 0.95rem;
    color: var(--mer-clair);
  }
</style>
