---
import { carteRegion } from "../data/contours";
import { villesOuElleEnseigne } from "../data/site";

// Contours OpenStreetMap figés par scripts/contours.mjs. On ne dessine que
// l'eau : la terre, c'est le fond. Les îles se lisent par les rivières qui
// les entourent, et il n'y a aucune frontière administrative à tenir à jour.
const { largeur, hauteur, projection, eaux } = carteRegion;

const projette = ({
  latitude,
  longitude,
}: {
  latitude: number;
  longitude: number;
}) => ({
  x:
    (longitude - projection.longitudeMin) *
    projection.aplatissement *
    projection.echelle,
  y: (projection.latitudeMax - latitude) * projection.echelle,
});

// Les étiquettes sont en HTML par-dessus le SVG : à l'intérieur, elles
// rétréciraient avec la carte jusqu'à devenir illisibles sur téléphone.
// Deux noms tiennent même sur un écran de 320 px, et ce sont eux qui situent
// tout le reste : sans « Montréal » sous l'île, la forme ne dit rien à qui ne
// connaît pas la région.
const REPERES = new Set(["Laval", "Montréal"]);

const villes = villesOuElleEnseigne.map((ville) => {
  const { x, y } = projette(ville);
  return {
    nom: ville.nom,
    x,
    y,
    estUnRepere: REPERES.has(ville.nom),
    gauche: (x / largeur) * 100,
    haut: (y / hauteur) * 100,
  };
});

const nomsDeVilles = villes.map((ville) => ville.nom);
---

<figure class="zone">
  <div class="zone__cadre">
    <svg
      viewBox={`0 0 ${largeur} ${hauteur}`}
      role="img"
      aria-labelledby="zone-titre zone-detail"
    >
      <title id="zone-titre">Carte des villes où Mariane se déplace</title>
      <desc id="zone-detail">
        Autour de l'île de Montréal et de Laval, les villes marquées d'un point
        sont {nomsDeVilles.join(", ")}.
      </desc>

      <rect class="zone__terre" width={largeur} height={hauteur}></rect>

      {eaux.map((plan) => <path class="zone__eau" d={plan.trace} />)}

      {
        villes.map((ville) => (
          <circle class="zone__point" cx={ville.x} cy={ville.y} r="9" />
        ))
      }
    </svg>

    {
      villes.map((ville) => (
        <span
          class:list={["zone__nom", { "zone__nom--repere": ville.estUnRepere }]}
          style={`left: ${ville.gauche}%; top: ${ville.haut}%`}
          aria-hidden="true"
        >
          {ville.nom}
        </span>
      ))
    }
  </div>

  <figcaption>
    <span class="zone__villes">{nomsDeVilles.join(", ")}.</span>{" "}
    <span>
      Fonds de carte{" "}
      <a href="https://www.openstreetmap.org/copyright" rel="noopener">
        © les contributeurs d'OpenStreetMap
      </a>.
    </span>
  </figcaption>
</figure>

<style>
  .zone {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    /* Les noms se règlent sur la largeur de la carte, pas sur celle de la
       fenêtre : la carte prend toute la largeur sur téléphone mais moins de
       la moitié sur grand écran, donc une requête de média dirait n'importe
       quoi. Le conteneur porte aussi la légende, qui prend le relais. */
    container-type: inline-size;
  }

  .zone__cadre {
    position: relative;
  }

  .zone svg {
    width: 100%;
    height: auto;
    border-radius: var(--rayon);
  }

  .zone__terre {
    fill: var(--sable);
  }

  .zone__eau {
    fill: #b6e3df;
    /* Les îles du fleuve sont des anneaux intérieurs du même tracé : c'est
       cette règle qui les rend en creux plutôt qu'en eau. */
    fill-rule: evenodd;
    /* Le liseré élargit les cours d'eau : à l'échelle de la région, la
       rivière des Prairies fait un cheveu — et c'est elle qui fait lire
       l'île de Montréal. */
    stroke: #b6e3df;
    stroke-width: 8;
    stroke-linejoin: round;
  }

  .zone__point {
    fill: var(--soleil-vif);
    stroke: var(--sable);
    stroke-width: 3;
  }

  /* Six noms sur une carte de 275 px se marchent dessus, quelle que soit la
     mise en page. En dessous du seuil, la légende prend le relais — c'est ce
     que fait n'importe quelle carte quand on dézoome. */
  .zone__nom {
    display: none;
  }

  .zone__nom,
  .zone__nom--repere {
    position: absolute;
    /* Sous le point, centrée : pas de décision gauche/droite à prendre, et
       aucune étiquette ne recouvre son propre repère. */
    transform: translate(-50%, 0.5rem);
    font-size: clamp(0.85rem, 2.3cqw, 1rem);
    font-weight: 700;
    color: var(--encre);
    white-space: nowrap;
    text-shadow:
      0 0 4px var(--sable),
      0 0 8px var(--sable),
      0 0 12px var(--sable);
  }

  .zone__nom--repere {
    display: block;
  }

  @container (min-width: 25rem) {
    .zone__nom {
      display: block;
    }
  }

  /* Les noms passent de la carte à la légende, jamais les deux à la fois :
     répétés, ils ne sont que du bruit, et une puce de la même couleur pour
     chaque ville ne ferait qu'imiter une légende sans rien expliquer. */
  @container (min-width: 25rem) {
    .zone__villes {
      display: none;
    }
  }

  .zone figcaption {
    display: grid;
    gap: 0.35rem;
    color: var(--encre-doux);
    font-size: 0.8rem;
  }

  .zone__villes {
    color: var(--encre);
    font-size: 1rem;
    font-weight: 600;
  }
</style>
