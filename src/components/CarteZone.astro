---
import { carteRegion } from "../data/contours";
import { zonesDesservies } from "../data/site";

// Les contours viennent d'OpenStreetMap, figés par scripts/contours.mjs : on
// reconnaît l'île de Montréal et l'île Jésus au premier coup d'œil, sans
// dépendre d'une capture de Google Maps ni de ses conditions d'utilisation.
const { largeur, hauteur, projection, territoires } = carteRegion;

type Lieu = { latitude: number; longitude: number };

const projette = ({ latitude, longitude }: Lieu) => ({
  x:
    projection.marge +
    (longitude - projection.longitudeMin) *
      projection.aplatissement *
      projection.echelle,
  y:
    projection.marge + (projection.latitudeMax - latitude) * projection.echelle,
});

// En pourcentage, pour poser les étiquettes en HTML par-dessus le SVG : du
// texte dans un SVG rétrécit avec lui et devient vite illisible.
const enPourcentage = (lieu: Lieu) => {
  const { x, y } = projette(lieu);
  return { gauche: (x / largeur) * 100, haut: (y / hauteur) * 100 };
};

// Posées à la main sur une zone dégagée de chaque territoire : un centroïde
// de forme concave tombe régulièrement dans l'eau.
const etiquettes = [
  { nom: "Rive-Nord", latitude: 45.757, longitude: -73.855 },
  { nom: "Laval", latitude: 45.598, longitude: -73.742 },
  { nom: "Montréal", latitude: 45.487, longitude: -73.68 },
].map((etiquette) => ({ ...etiquette, ...enPourcentage(etiquette) }));

const villes = zonesDesservies.map((ville) => ({
  nom: ville.nom,
  ...projette(ville),
}));

const nomsDeVilles = villes.map((ville) => ville.nom);
---

<figure class="zone">
  <div class="zone__cadre">
    <svg
      viewBox={`0 0 ${largeur} ${hauteur}`}
      role="img"
      aria-labelledby="zone-titre zone-detail"
    >
      <title id="zone-titre">Carte des territoires où Mariane se déplace</title>
      <desc id="zone-detail">
        Laval, l'île de Montréal et la Rive-Nord sont mises en évidence. Les
        villes marquées d'un point sont {nomsDeVilles.join(", ")}.
      </desc>

      <rect class="zone__eau" width={largeur} height={hauteur}></rect>

      {
        territoires.map((territoire) => (
          <path
            class:list={[
              "zone__terre",
              { "zone__terre--desservie": territoire.desservi },
            ]}
            d={territoire.trace}
          />
        ))
      }

      {
        villes.map((ville) => (
          <circle class="zone__point" cx={ville.x} cy={ville.y} r="8" />
        ))
      }
    </svg>

    {
      etiquettes.map((etiquette) => (
        <span
          class="zone__territoire"
          style={`left: ${etiquette.gauche}%; top: ${etiquette.haut}%`}
          aria-hidden="true"
        >
          {etiquette.nom}
        </span>
      ))
    }
  </div>

  <figcaption>
    Villes desservies&nbsp;: {nomsDeVilles.join(", ")}. Fonds de carte{" "}
    <a href="https://www.openstreetmap.org/copyright" rel="noopener">
      © les contributeurs d'OpenStreetMap
    </a>.
  </figcaption>
</figure>

<style>
  .zone {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .zone__cadre {
    position: relative;
  }

  .zone svg {
    width: 100%;
    height: auto;
    border-radius: var(--rayon);
  }

  .zone__eau {
    fill: var(--mer-brume);
  }

  .zone__terre {
    fill: var(--sable);
    stroke: var(--mer);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .zone__point {
    fill: var(--soleil-vif);
    stroke: var(--sable);
    stroke-width: 3;
  }

  .zone__territoire {
    position: absolute;
    transform: translate(-50%, -50%);
    font-weight: 700;
    font-size: 1rem;
    color: var(--mer-sombre);
    white-space: nowrap;
    /* Le halo garde le nom lisible même s'il passe sur une côte */
    text-shadow:
      0 0 4px var(--sable),
      0 0 8px var(--sable);
  }

  .zone figcaption {
    color: var(--encre-doux);
    font-size: 0.9rem;
  }
</style>
