---
import Vague from "./Vague.astro";
import { licence } from "../data/site";

// Section écrite pour les coordonnateurs de loisirs : ce qu'ils devront
// justifier auprès de leur direction, pas ce qui fait rêver le grand public.
const arguments_ = [
  {
    titre: "Les gens viennent pour la musique",
    texte:
      "Salsa, merengue, cumbia. Vous n'aurez pas à cogner aux portes\u00a0: c'est la musique qui fait sortir les gens de leur chambre.",
  },
  {
    titre: "Le cours se danse aussi assis",
    texte:
      "Chaque mouvement a sa variante assise. Une hanche qui bloque, un déambulateur\u00a0: la personne danse quand même, avec le groupe.",
  },
  {
    titre: "Vous fournissez la salle et les chaises",
    texte:
      "Elle apporte la musique et le matériel. Vous n'avez rien à installer, rien à louer.",
  },
  {
    titre: "Elle sait tenir un groupe",
    texte:
      "Licences Zumba® et Zumba Gold® à jour, vérifiables en ligne. Sentir quand un groupe fatigue et le relancer, ça vient de ses années de danse.",
  },
];
---

<section class="section section--mer" id="bienfaits">
  <Vague couleur="var(--mer-sombre)" bord="haut" />
  <Vague couleur="var(--mer-sombre)" bord="bas" />

  <div class="enveloppe">
    <h2>Pourquoi les organismes la rappellent</h2>
    <p class="chapeau">
      Ce que ça donne dans votre salle, et ce que ça vous demande.
    </p>

    <ul class="arguments">
      {
        arguments_.map((argument) => (
          <li class="argument">
            <h3>{argument.titre}</h3>
            <p>{argument.texte}</p>
          </li>
        ))
      }
    </ul>

    <p class="licence">
      Membre licenciée du <strong>Zumba Instructor Network</strong>, ZIN n<sup
        >o</sup
      >&nbsp;{licence.zinId} ({licence.intitules.join(" et ")}).{" "}
      <a href={licence.profil} rel="noopener">Voir sa fiche sur zumba.com</a>.
    </p>
  </div>
</section>

<style>
  .arguments {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
  }

  .argument h3 {
    display: flex;
    gap: 0.75rem;
  }

  .argument h3::before {
    content: "";
    flex: 0 0 auto;
    width: 0.35rem;
    border-radius: 999px;
    background: var(--soleil);
  }

  .argument p {
    color: var(--mer-brume);
    margin: 0;
  }

  .licence {
    margin: 2.5rem 0 0;
    padding: 1rem 1.5rem;
    max-width: none;
    border-radius: var(--rayon);
    background: rgb(255 255 255 / 0.08);
    color: var(--mer-brume);
    font-size: 0.95rem;
  }

  .licence strong {
    color: var(--sable);
  }
</style>
