---
import CarteZone from "./CarteZone.astro";
import { autresVillesDesservies } from "../data/site";

// Sert autant au visiteur qu'au référencement local : c'est la page qui doit
// sortir sur « zumba aînés résidence laval ».
const milieux = [
  {
    nom: "Résidences pour aînés",
    detail: "Salle commune, format hebdomadaire",
  },
  { nom: "Centres communautaires", detail: "Sessions à la saison" },
  { nom: "Écoles et parascolaire", detail: "Périodes de 45 à 60 minutes" },
  { nom: "Camps de jour", detail: "Demi-journées et blocs d'animation" },
  { nom: "Centres de périnatalité", detail: "Cours mamans-bébés" },
  { nom: "Événements ponctuels", detail: "Initiations et portes ouvertes" },
];
---

<section class="section section--creuse" id="lieux">
  <div class="enveloppe">
    <h2>Où Mariane se déplace</h2>
    <p class="chapeau">Laval, Montréal et la Rive-Nord.</p>
    <p class="precision">
      Sur la Rive-Nord&nbsp;: {autresVillesDesservies.slice(0, -1).join(", ")}
      {" "}et {autresVillesDesservies.at(-1)}.
    </p>

    <div class="lieux">
      <CarteZone />

      <ul class="milieux">
        {
          milieux.map((milieu) => (
            <li class="milieu">
              <strong>{milieu.nom}</strong>
              <span>{milieu.detail}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .lieux {
    margin-top: 2.5rem;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .lieux {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  .milieux {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
  }

  .milieu {
    display: grid;
    gap: 0.15rem;
    padding: 1rem 1.25rem;
    background: #fff;
    border-radius: var(--rayon);
    border-left: 4px solid var(--mer-clair);
  }

  .milieu span {
    font-size: 0.9rem;
    color: var(--encre-doux);
  }

  /* Ce que « Rive-Nord » veut dire, en toutes lettres : c'est sur ces noms-là
     qu'un coordonnateur cherche. Plus petit que le chapeau, il précise sans
     prendre sa place. */
  .precision {
    margin-top: -0.5rem;
    max-width: 60ch;
    font-size: 0.95rem;
    color: var(--encre-doux);
  }
</style>
