---
// Emplacement réservé, en attendant les photos et vidéos de Mariane.
// Visible et explicite : on doit voir d'un coup d'œil ce qu'il reste à fournir.
type Props = { legende: string; ratio?: string };
const { legende, ratio = "16 / 9" } = Astro.props;
---

<figure class="media-absent" style={`--ratio: ${ratio}`}>
  <span class="media-absent__icone" aria-hidden="true">📷</span>
  <figcaption class="media-absent__legende">{legende}</figcaption>
</figure>

<style>
  .media-absent {
    aspect-ratio: var(--ratio);
    margin: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    padding: 1.5rem;
    text-align: center;
    border: 2px dashed var(--mer-clair);
    border-radius: var(--rayon);
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0 12px,
        rgb(127 209 206 / 0.12) 12px 24px
      ),
      var(--mer-brume);
    color: var(--mer-sombre);
  }

  .media-absent__icone {
    font-size: 2rem;
  }

  .media-absent__legende {
    font-size: 0.9rem;
    font-weight: 600;
    max-width: 28ch;
  }
</style>
