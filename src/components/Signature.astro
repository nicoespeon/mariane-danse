---
// Les lettres ondulent comme une vague — clin d'œil à « la mer qu'on voit danser ».
// Découpées, elles deviennent illisibles pour un lecteur d'écran : on double le
// texte en version lisible et on masque les fragments.
type Props = { texte: string; class?: string };
const { texte, class: classe } = Astro.props;
const lettres = [...texte];
---

<span class:list={["signature", classe]}>
  <span class="visuellement-cache">{texte}</span>
  <span aria-hidden="true">
    {
      lettres.map((lettre, index) => (
        <span class="signature__lettre" style={`--rang: ${index}`}>
          {/* Une espace ordinaire s'écrase dans un inline-block */}
          {lettre === " " ? "\u00a0" : lettre}
        </span>
      ))
    }
  </span>
</span>

<style>
  .signature {
    display: inline-block;
    font-family: var(--police-titre);
    font-style: italic;
    font-weight: 400;
  }

  .signature__lettre {
    display: inline-block;
    animation: ondule 3.6s ease-in-out infinite;
    animation-delay: calc(var(--rang) * 55ms);
    will-change: transform;
  }

  @keyframes ondule {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.18em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature__lettre {
      animation: none;
    }
  }
</style>
