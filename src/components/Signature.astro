---
// Les lettres ondulent comme une vague — clin d'œil à « la mer qu'on voit danser ».
// Découpées, elles deviennent illisibles pour un lecteur d'écran : on expose le
// texte entier via aria-label et on cache les fragments.
type Props = { texte: string; class?: string };
const { texte, class: classe } = Astro.props;
const lettres = [...texte];
---

<span class:list={["signature", classe]} aria-label={texte}>
  {
    lettres.map((lettre, index) => (
      <span
        aria-hidden="true"
        class="signature__lettre"
        style={`--rang: ${index}`}
      >
        {lettre === " " ? " " : lettre}
      </span>
    ))
  }
</span>

<style>
  .signature {
    display: inline-block;
    font-family: var(--police-titre);
    font-style: italic;
    font-weight: 400;
  }

  .signature__lettre {
    display: inline-block;
    animation: ondule 3.6s ease-in-out infinite;
    animation-delay: calc(var(--rang) * 55ms);
    will-change: transform;
  }

  @keyframes ondule {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.18em);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature__lettre {
      animation: none;
    }
  }
</style>
