---
// Glyphe officiel, redessiné en un seul tracé : une image chargée depuis un
// CDN ferait une requête tierce, et un emoji ne se reconnaît pas.
type Props = { taille?: string; degrade?: boolean };
const { taille = "1.25em", degrade = false } = Astro.props;

// Deux dégradés portant le même identifiant dans une page, et le HTML devient
// invalide : chaque instance tire le sien.
const idDegrade = `instagram-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill={degrade ? `url(#${idDegrade})` : "currentColor"}
  aria-hidden="true"
  focusable="false"
>
  {
    degrade && (
      <defs>
        <radialGradient id={idDegrade} cx="30%" cy="107%" r="150%">
          <stop offset="0%" stop-color="#fdf497" />
          <stop offset="8%" stop-color="#fdf497" />
          <stop offset="45%" stop-color="#fd5949" />
          <stop offset="62%" stop-color="#d6249f" />
          <stop offset="90%" stop-color="#4f5bd5" />
        </radialGradient>
      </defs>
    )
  }

  <path
    d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.06 1.8.25 2.23.42.56.21.96.47 1.38.89.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.06 1.17-.26 1.8-.42 2.23a3.7 3.7 0 0 1-.9 1.38c-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.06-1.82-.26-2.24-.42a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.42-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.86c.06-1.17.25-1.81.42-2.23.21-.57.48-.96.9-1.38.42-.42.81-.69 1.38-.9.42-.17 1.05-.36 2.22-.42C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.02 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.38A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.02 8.33 0 8.74 0 12s.02 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.77.3 1.64.5 2.91.56C8.33 23.98 8.74 24 12 24s3.67-.02 4.95-.07c1.28-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.02-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.02 15.26 0 12 0z"
  ></path>
  <path
    d="M12 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"
  ></path>
  <circle cx="18.41" cy="5.6" r="1.44"></circle>
</svg>

<style>
  svg {
    flex: 0 0 auto;
  }
</style>
