---
// « Un vrai soleil » — sa qualité la plus citée, devenue élément graphique.
---

<svg class="soleil" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <g class="soleil__rayons">
    {
      Array.from({ length: 12 }, (_, i) => (
        <rect
          x="97"
          y="6"
          width="6"
          height="26"
          rx="3"
          transform={`rotate(${i * 30} 100 100)`}
        />
      ))
    }
  </g>
  <circle class="soleil__coeur" cx="100" cy="100" r="52"></circle>
</svg>

<style>
  .soleil {
    width: 100%;
    height: auto;
  }

  .soleil__rayons {
    fill: var(--soleil);
    transform-origin: 100px 100px;
    animation: tourne 90s linear infinite;
  }

  .soleil__coeur {
    fill: var(--soleil-vif);
  }

  @keyframes tourne {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .soleil__rayons {
      animation: none;
    }
  }
</style>
