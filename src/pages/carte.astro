---
import QRCode from "qrcode";
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { ficheContact } from "../data/fiche-contact";

// Page conçue pour être tendue à bout de bras après un cours : Mariane
// l'ouvre sur son téléphone, la personne en face scanne. Pas d'application,
// pas de compte, pas de Linktree.
//
// Le code encode la fiche de contact elle-même, pas l'adresse du site : la
// personne scanne et Mariane est dans son répertoire, sans réseau ni
// téléchargement. L'adresse du site voyage dans la fiche, donc rien n'est
// perdu. Les boutons plus bas servent l'autre entrée : quelqu'un à qui
// Mariane a envoyé le lien, et qui lit déjà la page sur son téléphone.
const qr = await QRCode.toString(ficheContact(Astro.site), {
  type: "svg",
  margin: 0,
  errorCorrectionLevel: "M",
  color: { dark: "#14262c", light: "#0000" },
});
---

<Base
  titre={`Carte de visite — ${site.nom}`}
  description="Scannez pour retrouver Mariane."
  navigation={false}
>
  <div class="carte">
    <p class="carte__sur-titre">{site.metier}</p>
    <h1>{site.nom}</h1>

    <div class="carte__qr" set:html={qr} aria-hidden="true" />
    <p class="carte__consigne">
      Pointez votre appareil photo ici&nbsp;: Mariane s'ajoute à vos contacts.
    </p>

    <div class="carte__secondaire">
      <p class="carte__ou">Vous lisez déjà ceci sur votre téléphone?</p>

      <a class="bouton bouton--principal" href="/contact.vcf">
        Ajouter à mes contacts
      </a>

      <ul class="carte__liens">
        <li>
          <a href={`tel:${site.telephone}`}>{site.telephoneAffiche}</a>
        </li>
        <li><a href="/">Voir le site</a></li>
        <li>
          <button class="carte__partage" type="button" hidden>Partager</button>
        </li>
      </ul>
    </div>
  </div>
</Base>

<script>
  // Le partage natif n'existe pas partout : le bouton n'apparaît que s'il marche.
  const bouton = document.querySelector<HTMLButtonElement>(".carte__partage");

  if (bouton && navigator.share) {
    bouton.hidden = false;
    bouton.addEventListener("click", async () => {
      try {
        await navigator.share({
          title: document.title,
          url: new URL("/", location.href).href,
        });
      } catch {
        // Partage annulé par la personne : rien à signaler.
      }
    });
  }
</script>

<style>
  .carte {
    min-height: 100dvh;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1rem;
    padding: 2rem var(--gouttiere);
    text-align: center;
    background:
      radial-gradient(90% 60% at 50% 0%, var(--sable-creux), transparent 70%),
      var(--sable);
  }

  .carte__sur-titre {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mer);
  }

  .carte h1 {
    font-size: clamp(2rem, 8vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .carte__qr {
    width: min(22rem, 78vw);
    /* Un code QR a besoin d'une zone calme d'au moins quatre modules ; à
       cette densité, ça fait à peu près cette marge. */
    padding: 1.5rem;
    background: #fff;
    border-radius: var(--rayon-large);
    box-shadow: var(--ombre-levee);
  }

  .carte__qr :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .carte__consigne {
    margin: 0;
    color: var(--encre-doux);
    font-size: 0.95rem;
  }

  .carte__consigne {
    max-width: 26ch;
  }

  /* Deux entrées, deux publics : le code pour la personne en face de Mariane,
     les boutons pour celle à qui elle a envoyé le lien. Un trait sépare les
     deux plutôt qu'un empilement qui laisse croire à une seule marche. */
  .carte__secondaire {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(20 38 44 / 0.12);
    width: min(30rem, 100%);
  }

  .carte__ou {
    margin: 0;
    color: var(--encre-doux);
    font-size: 0.95rem;
  }

  .carte__liens {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 1.5rem;
  }

  .carte__liens a,
  .carte__partage {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--mer);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 0.08em;
    cursor: pointer;
  }

  .carte__liens a:hover,
  .carte__partage:hover {
    color: var(--mer-sombre);
  }
</style>
