{
  "name": "mariane-danse",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "servir": "sirv dist --port 4331 --quiet",
    "check": "pnpm run format:check && pnpm run check:lint && pnpm run check:types && pnpm run check:morts && pnpm run build && pnpm run check:typo && pnpm run check:e2e && pnpm run check:quality",
    "check:lint": "eslint .",
    "check:types": "astro check",
    "check:morts": "knip",
    "check:typo": "node scripts/typographie.mjs",
    "check:e2e": "playwright test",
    "check:quality": "node scripts/lighthouse.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/fraunces": "5.3.0",
    "astro": "7.2.9",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@types/qrcode": "1.5.6",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.11.0",
    "knip": "6.32.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "puppeteer": "25.9.0",
    "qrcode": "1.5.4",
    "sirv-cli": "3.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "description": "Site vitrine de Mariane Rollot Carlo, instructrice de Zumba",
  "private": true,
  "packageManager": "pnpm@10.12.1"
}
